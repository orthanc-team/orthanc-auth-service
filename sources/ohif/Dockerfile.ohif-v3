######################################################

FROM node:24.22.2-slim AS sourcer

RUN apt-get update && apt-get install -y git

WORKDIR /usr/src

RUN git clone https://github.com/OHIF/Viewers.git app-git-repo && cd /usr/src/app-git-repo && git checkout v3.13.15


FROM node:24.22.2-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends build-essential python3 && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@12

RUN mkdir /usr/src/app
RUN mkdir /usr/src/app-git-repo

WORKDIR /usr/src/app

ENV PATH=/usr/src/app/node_modules/.bin:$PATH

# clone the repo in a temporary folder and then, copy from there only when needed
COPY --from=sourcer /usr/src/app-git-repo /usr/src/app-git-repo

# Do an initial install and then a final install
RUN cp /usr/src/app-git-repo/package.json ./
RUN cp /usr/src/app-git-repo/pnpm-lock.yaml ./
RUN cp /usr/src/app-git-repo/pnpm-workspace.yaml ./
RUN cp /usr/src/app-git-repo/.npmrc ./
RUN cp /usr/src/app-git-repo/preinstall.js ./

WORKDIR /usr/src/app-git-repo
RUN cp --parents ./extensions/*/package.json ./modes/*/package.json ./platform/*/package.json /usr/src/app/

WORKDIR /usr/src/app

# Run the install before copying the rest of the files
RUN pnpm install --frozen-lockfile --filter '!ohif-docs'

WORKDIR /usr/src/app-git-repo
# this generates warnings but it is expected !
RUN cp --link -r . /usr/src/app || true 
WORKDIR /usr/src/app

ENV QUICK_BUILD=true
ENV PUBLIC_URL=/ohif/
ENV APP_CONFIG=config/default.js

RUN pnpm run show:config
RUN pnpm run build

# patch files where the PUBLIC_URL was not taken into account
RUN sed -i "s|var worker = new Worker(workerUrl|var worker = new Worker(new URL(window.location.protocol + '//' + window.location.host + window.location.pathname.replace('microscopy', 'dicom-microscopy-viewer') + '/dataLoader.worker.min.js')|g" /usr/src/app/platform/app/dist/dicom-microscopy-viewer/dicomMicroscopyViewer.min.js
RUN sed -i 's|"/assets/android-chrome-|"./assets/android-chrome-|g' /usr/src/app/platform/app/dist/manifest.json


# Precompress files
RUN chmod u+x .docker/compressDist.sh
RUN ./.docker/compressDist.sh

######################################################

FROM nginx/nginx-unprivileged:1.31.9-alpine

ENV PUBLIC_URL=/ohif/
ENV PORT=80

RUN rm /etc/nginx/conf.d/default.conf

USER nginx

COPY --from=sourcer --chown=nginx:nginx /usr/src/app-git-repo/.docker/Viewer-v3.x /usr/src
RUN chmod 777 /usr/src/entrypoint.sh
COPY --from=builder /usr/src/app/platform/app/dist /usr/share/nginx/html${PUBLIC_URL}
# Copy paths that are renamed/redirected generally
# Microscopy libraries depend on root level include, so must be copied
COPY --from=builder /usr/src/app/platform/app/dist/dicom-microscopy-viewer /usr/share/nginx/html/dicom-microscopy-viewer

# from v3.12.0, the app-config.js files has moved from /usr/share/nginx/html/ to /usr/share/nginx/html/ohif/
COPY default-app-config.js /usr/share/nginx/html/ohif/app-config.js

# In entrypoint.sh, app-config.js might be overwritten, so chmod it to be writeable.
# The nginx user cannot chmod it, so change to root.
USER root
RUN apk upgrade --no-cache
RUN mkdir -p /usr/share/nginx/html${PUBLIC_URL}plugins \
  && chown -R nginx:nginx /usr/share/nginx/html && chmod -R 777 /usr/share/nginx/html
USER nginx
ENTRYPOINT ["/usr/src/entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]